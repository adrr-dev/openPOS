# Server
PORT=8080

# PostgreSQL (Supabase) — ambil dari Project Settings > Database > Connection string (pooler)
DATABASE_URL="postgresql://postgres.XXX:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT — ganti dengan string acak yang panjang (mis. `openssl rand -hex 32`)
JWT_SECRET=SERCRET
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# Origin frontend yang diizinkan CORS (pisahkan dengan koma)
# CORS_ORIGINS=https://open-pos-edit.vercel.app/
CORS_ORIGINS=http://localhost:5173
