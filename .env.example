# Server
PORT=8080

# Database selector:
#   Local sqlite  -> DB_DRIVER=sqlite + DATABASE_URL=openpos_test.db (or file:.../.db)
#   Supabase/Vercel -> leave DB_DRIVER unset (or =postgres) + DATABASE_URL=pooler string.
# On Vercel: do NOT set DB_DRIVER=sqlite; set DATABASE_URL to the 6543 pooler URL.
DB_DRIVER=
LOG_SQL=

# PostgreSQL (Supabase) — ambil dari Project Settings > Database > Connection string (pooler)
DATABASE_URL="postgresql://postgres.XXX:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT — ganti dengan string acak yang panjang (mis. `openssl rand -hex 32`)
JWT_SECRET=SECRET
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# Google login (GIS ID-token flow) — Client ID dari Google Cloud Console
# (OAuth client, tipe Web). Kosongkan untuk menonaktifkan POST /auth/google;
# alur OTP tetap jalan normal.
GOOGLE_CLIENT_ID=

# Origin frontend yang diizinkan CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:5173

## Email origin
SMTP_EMAIL=email
SMTP_PASSWORD=password
